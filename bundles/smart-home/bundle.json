            "component": "QuickTaskList",
            "clients": [
              "pc",
              "b-mobile"
            ],
            "props": {
              "tasks": [
                "复核线索用途授权",
                "领取获客模型任务",
                "查看方案与报价待审",
                "检查现场验收证据"
              ]
            }
          }
        ]
      },
      "welcome": {
        "system": [
          "这是一套全屋智能门店经营管理系统。数字员工整理获客内容、需求、方案与经营汇报；本地规则核验引用和报价，现场专业行为、客户确认与对外承诺保留人类责任。"
        ],
        "keywords": [
          "有效线索",
          "精确兼容",
          "报价待审",
          "现场证据",
          "客户验收",
          "经营目标"
        ],
        "cards": [
          {
            "t": "把客户需求变成方案",
            "d": "从用途授权与装修阶段开始，把体验、专业勘测、设备兼容、空间场景和报价连成可核对的资料链。"
          },
          {
            "t": "让交付有据可验",
            "d": "采购、安装、调试、培训与签收按依赖推进；缺现场或客户证据时保持待办，不用内部进度代替客户验收。"
          },
          {
            "t": "由董事长掌握经营边界",
            "d": "目标、暂停、继续和关键批准留下回执；宿主工作台用内置模型领任务，未启用的发布、支付与设备控制不会冒称成功。"
          }
        ]
      },
