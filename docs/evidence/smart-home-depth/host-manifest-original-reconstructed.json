        "slots": [
          {
            "capabilityId": "smart-home.workbench",
            "title": "智能门店经营台",
            "route": "/smart-home/workbench",
            "group": "operations",
            "icon": "executive",
            "clients": [
              "pc",
              "b-mobile"
            ],
            "permissions": [
